#!/usr/bin/env bash
set -euo pipefail

MARKER_BEGIN="# surrogate:zmx:begin"
MARKER_END="# surrogate:zmx:end"
DEFAULT_MODE="all"
DEFAULT_CONFIG_PATH="${HOME:-}/.config/surrogate/shell.conf"

usage() {
  cat <<'EOF'
surrogate-shell-setup — install/manage zmx shell integration

Usage:
  surrogate-shell-setup [--show] [--mode MODE] [--commands LIST] [--config PATH]
      Show the snippet for your shell (default)
  surrogate-shell-setup --install [--mode MODE] [--commands LIST] [--config PATH]
      Install or refresh the managed snippet in your shell rc file
  surrogate-shell-setup --uninstall
      Remove snippet from your shell rc file
  surrogate-shell-setup --check
      Check if snippet is already installed
  surrogate-shell-setup --help
      Show this help

Modes:
  all       Wrap every new interactive shell in zmx (legacy/default behavior)
  commands  Leave plain shells alone; wrap only configured commands in zmx

Options:
  --mode MODE       Override shell integration mode (all|commands)
  --commands LIST   Command allowlist for commands mode (comma or space separated)
  --config PATH     Load settings from a shell config file

Environment:
  SURROGATE_NO_ZMX=1         Disable wrapping for the current shell session
  SURROGATE_SHELL_CONFIG     Default config path when --config is not passed
  SURROGATE_ZMX_MODE         Mode override (all|commands)
  SURROGATE_ZMX_COMMANDS     Command allowlist override for commands mode
  ZMX_SESSION                Set automatically by zmx (prevents double-wrapping)
EOF
}

die() {
  echo "surrogate-shell-setup: error: $*" >&2
  exit 1
}

detect_shell() {
  local sh
  sh="$(basename "${SHELL:-/bin/bash}")"
  case "$sh" in
    bash|zsh|fish) echo "$sh" ;;
    *) echo "bash" ;;
  esac
}

rc_file_for() {
  case "$1" in
    bash) echo "$HOME/.bashrc" ;;
    zsh)  echo "$HOME/.zshrc" ;;
    fish) echo "$HOME/.config/fish/config.fish" ;;
  esac
}

validate_mode() {
  case "$1" in
    all|commands) ;;
    *) die "invalid mode '$1' (expected: all or commands)" ;;
  esac
}

validate_command_name() {
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || die "invalid command name '$1' in allowlist"
}

normalize_commands() {
  local raw="$1"
  local normalized=""
  local token
  local -a tokens=()
  local -A seen=()

  raw="${raw//$'\n'/ }"
  raw="${raw//,/ }"
  read -r -a tokens <<< "$raw"

  for token in "${tokens[@]}"; do
    [[ -n "$token" ]] || continue
    validate_command_name "$token"
    [[ -n "${seen[$token]:-}" ]] && continue
    seen["$token"]=1
    if [[ -n "$normalized" ]]; then
      normalized+=" "
    fi
    normalized+="$token"
  done

  printf '%s' "$normalized"
}

command_metadata_id() {
  # Use a hex encoding instead of punctuation normalization so command names
  # like foo-bar, foo.bar, and foo_bar cannot share metadata variables.
  local cmd="$1" hex
  hex="$(printf '%s' "$cmd" | od -An -tx1 -v | tr -d ' \n')"
  printf 'cmd_%s' "$hex"
}

resolve_config_path() {
  local explicit_path="$1"

  if [[ -n "$explicit_path" ]]; then
    printf '%s' "$explicit_path"
    return 0
  fi

  if [[ -n "${SURROGATE_SHELL_CONFIG:-}" ]]; then
    printf '%s' "$SURROGATE_SHELL_CONFIG"
    return 0
  fi

  if [[ -f "$DEFAULT_CONFIG_PATH" ]]; then
    printf '%s' "$DEFAULT_CONFIG_PATH"
    return 0
  fi

  printf '%s' ""
}

load_config_values() {
  local path="$1"
  [[ -n "$path" ]] || return 0
  [[ -f "$path" ]] || die "config file not found: $path"

  local -a cfg_lines=()
  if ! mapfile -t cfg_lines < <(
    env -i HOME="$HOME" USER="${USER:-}" bash -c '
      set -euo pipefail
      source "$1"
      printf "%s\n" "${SURROGATE_ZMX_MODE-}"
      printf "%s\n" "${SURROGATE_ZMX_COMMANDS-}"
    ' bash "$path"
  ); then
    die "failed to read config file: $path"
  fi

  printf '%s\n%s' "${cfg_lines[0]:-}" "${cfg_lines[1]:-}"
}

RESOLVED_MODE="$DEFAULT_MODE"
RESOLVED_COMMANDS=""
ACTIVE_CONFIG_PATH=""

resolve_settings() {
  local explicit_config="$1"
  local cli_mode="$2"
  local cli_commands="$3"
  local -a cfg_values=()

  RESOLVED_MODE="$DEFAULT_MODE"
  RESOLVED_COMMANDS=""
  ACTIVE_CONFIG_PATH="$(resolve_config_path "$explicit_config")"

  if [[ -n "$ACTIVE_CONFIG_PATH" ]]; then
    mapfile -t cfg_values < <(load_config_values "$ACTIVE_CONFIG_PATH")
    [[ -n "${cfg_values[0]:-}" ]] && RESOLVED_MODE="${cfg_values[0]}"
    [[ -n "${cfg_values[1]:-}" ]] && RESOLVED_COMMANDS="${cfg_values[1]}"
  fi

  [[ -n "${SURROGATE_ZMX_MODE:-}" ]] && RESOLVED_MODE="$SURROGATE_ZMX_MODE"
  [[ -n "${SURROGATE_ZMX_COMMANDS:-}" ]] && RESOLVED_COMMANDS="$SURROGATE_ZMX_COMMANDS"
  [[ -n "$cli_mode" ]] && RESOLVED_MODE="$cli_mode"
  [[ -n "$cli_commands" ]] && RESOLVED_COMMANDS="$cli_commands"

  validate_mode "$RESOLVED_MODE"
  RESOLVED_COMMANDS="$(normalize_commands "$RESOLVED_COMMANDS")"

  if [[ "$RESOLVED_MODE" == "commands" && -z "$RESOLVED_COMMANDS" ]]; then
    die "commands mode requires at least one command"
  fi
}

bash_like_wrappers() {
  # Each wrapper dispatches on the kind captured at preamble time:
  #   - function: the user's shell function was renamed to
  #     `_SURR_ORIG_<cmd>_fn`. We write that captured body to a private
  #     temporary script and run it inside zmx. This avoids bash function
  #     exports (`BASH_FUNC_*` env leakage) while still making function-backed
  #     command wrappers work.
  #   - alias:   tokenize the captured expansion and wrap+exec inside zmx.
  #   - bare:    wrap+exec the command name itself inside zmx.
  local commands="$1"
  local cmd sanitized
  for cmd in $commands; do
    sanitized="$(command_metadata_id "$cmd")"
    printf '    %s() {\n' "$cmd"
    printf '      case "${_SURR_KIND_%s:-bare}" in\n' "$sanitized"
    printf '        function) _surr_wrap_function %s _SURR_ORIG_%s_fn "$@" ;;\n' "$cmd" "$sanitized"
    printf '        alias)    local -a __t; read -ra __t <<< "${_SURR_ALIAS_%s}"; _surr_wrap_command %s "${__t[@]}" "$@" ;;\n' "$sanitized" "$cmd"
    printf '        *)        _surr_wrap_command %s %s "$@" ;;\n' "$cmd" "$cmd"
    printf '      esac\n'
    printf '    }\n'
  done
}

bash_like_alias_preamble() {
  # For each wrapped command, capture the user's original meaning
  # (shell function, shell alias, or bare binary) before our wrapper
  # shadows it. This preamble runs as top-level statements BEFORE the
  # wrapper `if` block, for two load-bearing reasons:
  #
  # (1) User aliases like `alias foo='bar --some-flag'` and user
  #     functions like `foo() { ... real work ... }` would otherwise be
  #     destroyed: our wrapper function `<cmd>() { ... }` shadows them.
  #     The captured value lets the wrapper still run the user's
  #     intended command.
  #
  # (2) Bash parses a compound command (like an `if` block) as a unit
  #     and alias-expands inside it at parse time, so a runtime
  #     `unalias` inside the block fires too late: if the rc file
  #     earlier did `alias foo="bar ..."` for one of our wrapped
  #     commands, the function NAME `foo` in `foo() { ... }` would be
  #     alias-expanded during the block parse and cause a syntax
  #     error. Running the unalias/unset as top-level statements first
  #     means they execute before the block is read, so the function
  #     definitions inside the block parse cleanly.
  #
  # For function-backed commands we deliberately do NOT export the renamed
  # function — that would leak the body into child-process environments as
  # `BASH_FUNC_<name>%%=...`. The wrapper serializes the captured function to
  # a private temp script at call time and runs that script inside zmx.
  local commands="$1"
  [[ -n "$commands" ]] || return 0

  # Emit a one-time `_surr_capture_cmd` helper, then call it per command.
  cat <<'PREAMBLE_EOF'
_surr_capture_cmd() {
  local _surr_cmd="$1"
  local _surr_sanitized="$2"
  local _surr_alias_val
  _surr_alias_val="$(alias "$_surr_cmd" 2>/dev/null | sed -E "s/^alias [^=]+='(.*)'\$/\1/")"
  unalias "$_surr_cmd" 2>/dev/null || true
  if [[ -n "$_surr_alias_val" ]]; then
    unset -f "$_surr_cmd" 2>/dev/null || true
    printf -v "_SURR_ALIAS_${_surr_sanitized}" '%s' "$_surr_alias_val"
    eval "_SURR_KIND_${_surr_sanitized}=alias"
    return 0
  fi
  if declare -f "$_surr_cmd" >/dev/null 2>&1; then
    eval "$(declare -f "$_surr_cmd" | sed "1s/^$_surr_cmd /_SURR_ORIG_${_surr_sanitized}_fn /")"
    unset -f "$_surr_cmd"
    eval "_SURR_KIND_${_surr_sanitized}=function"
  else
    eval "_SURR_KIND_${_surr_sanitized}=bare"
  fi
}
PREAMBLE_EOF

  local cmd sanitized
  for cmd in $commands; do
    sanitized="$(command_metadata_id "$cmd")"
    printf '_surr_capture_cmd %s %s\n' "$cmd" "$sanitized"
  done
  printf 'unset -f _surr_capture_cmd\n'
}

fish_wrappers() {
  local commands="$1"
  local cmd
  for cmd in $commands; do
    printf "    function %s --wraps %s --description 'surrogate zmx wrapper for %s'\n" "$cmd" "$cmd" "$cmd"
    printf '      _surr_wrap_command %s $argv\n' "$cmd"
    printf '    end\n'
  done
}

snippet_for_bash_like() {
  local mode="$1"
  local commands="$2"
  local commands_comment="${commands:-<none>}"

  printf '%s\n' \
    "$MARKER_BEGIN" \
    '# surrogate: zmx integration for interactive terminals' \
    "# Mode: $mode" \
    "# Commands: $commands_comment" \
    '# Uses full path to zmx — this runs before PATH is configured in .bashrc.' \
    '# Checks parent process to avoid double-wrapping (env var leaks to children).' \
    '# INVARIANT: commands mode is silent at startup; all mode prints on wrap and inherited-session paths.'

  if [[ "$mode" == "commands" ]]; then
    bash_like_alias_preamble "$commands"
  fi

  cat <<'EOF'
if [[ $- == *i* ]]; then
  zmx() {
    local _surr_real_zmx="${ZMX_BIN:-$HOME/.local/bin/zmx}"
    if [[ ! -x "$_surr_real_zmx" ]]; then
      command zmx "$@"
      return
    fi
    case "${1:-}" in
      attach|a)
        env -u ZMX_SESSION "$_surr_real_zmx" "$@"
        ;;
      *)
        "$_surr_real_zmx" "$@"
        ;;
    esac
  }

  _surr_parent_name() {
    ps -o comm= -p "$PPID" 2>/dev/null || true
  }

  _surr_print_status() {
    local _surr_zmx="${ZMX_BIN:-$HOME/.local/bin/zmx}"
    local _surr_surrogate="${SURROGATE_BIN:-$HOME/.local/bin/surrogate}"
    local _surr_alias=""
    local _surr_path="$(dirname "$_surr_surrogate"):$(dirname "$_surr_zmx"):${PATH:-/usr/bin:/bin}"
    if [[ -n "${SURROGATE_NO_ZMX:-}" ]]; then
      return 0
    fi
    if [[ -n "${ZMX_SESSION:-}" && -x "$_surr_surrogate" ]]; then
      _surr_alias="$(PATH="$_surr_path" "$_surr_surrogate" alias "$ZMX_SESSION" 2>/dev/null || true)"
    fi
    if [[ -n "$_surr_alias" ]]; then
      echo "surrogate: zmx session ${ZMX_SESSION:-inherited} alias $_surr_alias"
    else
      echo "surrogate: zmx session ${ZMX_SESSION:-inherited}"
    fi
  }

  _surr_wrap_command() {
    # Signature: _surr_wrap_command <label> <real_cmd_tokens...> <user_args...>
    #   <label>           — session-name prefix and banner text (e.g. "mycli")
    #   <real_cmd_tokens> — the actual command + flags to exec (e.g. "claude" "--dangerously-skip-permissions").
    #                       Comes from the captured original alias expansion, or
    #                       defaults to the bare command name when there was no alias.
    #   <user_args>       — whatever the user typed after the wrapped command name.
    # After shifting off <label>, "$@" is the full exec list we hand to zmx.
    local _surr_label="$1"
    shift
    local _surr_zmx="${ZMX_BIN:-$HOME/.local/bin/zmx}"
    local _surr_surrogate="${SURROGATE_BIN:-$HOME/.local/bin/surrogate}"
    local _surr_path="$(dirname "$_surr_surrogate"):$(dirname "$_surr_zmx"):${PATH:-/usr/bin:/bin}"
    local _surr_parent=""
    local _surr_name=""
    local _surr_alias=""
    if [[ -n "${SURROGATE_NO_ZMX:-}" || ! -x "$_surr_zmx" ]]; then
      command "$@"
      return
    fi
    _surr_parent="$(_surr_parent_name)"
    if [[ -n "${ZMX_SESSION:-}" || "$_surr_parent" == "zmx" ]]; then
      # Already inside zmx — announce current session and run inline.
      # Use plain `alias` (not --predict) so renames via `surrogate rename` win.
      if [[ -n "${ZMX_SESSION:-}" && -x "$_surr_surrogate" ]]; then
        _surr_alias="$(PATH="$_surr_path" "$_surr_surrogate" alias "$ZMX_SESSION" 2>/dev/null || true)"
      fi
      if [[ -n "$_surr_alias" ]]; then
        echo "surrogate: zmx session ${ZMX_SESSION:-inherited} alias $_surr_alias"
      else
        echo "surrogate: zmx session ${ZMX_SESSION:-inherited}"
      fi
      command "$@"
      return
    fi
    _surr_name="${_surr_label}-$(date +'%Y-%m-%d_%H-%M-%S_%Z')-$$"
    if [[ -x "$_surr_surrogate" ]]; then
      _surr_alias="$(PATH="$_surr_path" "$_surr_surrogate" alias --predict "$_surr_name" 2>/dev/null || true)"
    fi
    if [[ -n "$_surr_alias" ]]; then
      echo "surrogate: zmx session $_surr_name alias $_surr_alias"
    else
      echo "surrogate: zmx session $_surr_name"
    fi
    env -u ZMX_SESSION "$_surr_zmx" attach "$_surr_name" "$@"
  }

  _surr_wrap_function() {
    local _surr_label="$1"
    local _surr_fn="$2"
    shift 2
    local _surr_tmp=""
    local _surr_shell="${SHELL:-/bin/bash}"
    local _surr_status=0
    _surr_tmp="$(mktemp "${TMPDIR:-/tmp}/surrogate-fn.${_surr_label}.XXXXXX")" || return 1
    chmod 600 "$_surr_tmp" 2>/dev/null || true
    {
      printf '%s\n' 'trap '\''rm -f "$0"'\'' EXIT'
      declare -f "$_surr_fn"
      printf '\n%s "$@"\n' "$_surr_fn"
    } > "$_surr_tmp"
    _surr_wrap_command "$_surr_label" "$_surr_shell" "$_surr_tmp" "$@"
    _surr_status=$?
    [[ -e "$_surr_tmp" ]] && rm -f "$_surr_tmp"
    return "$_surr_status"
  }

  _surr_parent="$(_surr_parent_name)"
EOF

  if [[ "$mode" == "commands" ]]; then
    cat <<'EOF'
  if [[ "$_surr_parent" != "zmx" ]]; then
    unset ZMX_SESSION
  fi
EOF
    bash_like_wrappers "$commands"
  else
    cat <<'EOF'
  if [[ "$_surr_parent" == "zmx" ]]; then
    _surr_print_status
  elif [[ -z "${SURROGATE_NO_ZMX:-}" ]]; then
    _surr_zmx="${ZMX_BIN:-$HOME/.local/bin/zmx}"
    if [[ -x "$_surr_zmx" ]]; then
      _surr_name="$(date +'%Y-%m-%d_%H-%M-%S_%Z')-$$"
      echo "surrogate: wrapping in zmx session $_surr_name"
      unset ZMX_SESSION
      exec "$_surr_zmx" attach "$_surr_name"
    fi
  fi
EOF
  fi

  printf '%s\n' '  unset _surr_parent' 'fi' "$MARKER_END"
}

snippet_for_fish() {
  local mode="$1"
  local commands="$2"
  local commands_comment="${commands:-<none>}"

  printf '%s\n' \
    "$MARKER_BEGIN" \
    '# surrogate: zmx integration for interactive terminals' \
    "# Mode: $mode" \
    "# Commands: $commands_comment" \
    '# INVARIANT: commands mode is silent at startup; all mode prints on wrap and inherited-session paths.'

  cat <<'EOF'
if status is-interactive
  function zmx --description 'surrogate nested zmx attach shim'
    set -l _surr_real_zmx (set -q ZMX_BIN; and echo $ZMX_BIN; or echo $HOME/.local/bin/zmx)
    if not test -x "$_surr_real_zmx"
      command zmx $argv
      return $status
    end
    if test (count $argv) -ge 1
      switch "$argv[1]"
        case attach a
          env -u ZMX_SESSION "$_surr_real_zmx" $argv
          return $status
      end
    end
    "$_surr_real_zmx" $argv
    return $status
  end

  function _surr_parent_name
    set -l _surr_ppid (ps -o ppid= -p $fish_pid 2>/dev/null | string trim)
    if test -n "$_surr_ppid"
      ps -o comm= -p $_surr_ppid 2>/dev/null | string trim
    end
  end

  function _surr_print_status
    if set -q SURROGATE_NO_ZMX
      return 0
    end
    set -l _surr_zmx (set -q ZMX_BIN; and echo $ZMX_BIN; or echo $HOME/.local/bin/zmx)
    set -l _surr_surrogate (set -q SURROGATE_BIN; and echo $SURROGATE_BIN; or echo $HOME/.local/bin/surrogate)
    set -l _surr_alias ""
    set -l _surr_session (set -q ZMX_SESSION; and echo $ZMX_SESSION; or echo inherited)
    set -l _surr_path (dirname "$_surr_surrogate")":"(dirname "$_surr_zmx")":"(string join ":" $PATH)
    if set -q ZMX_SESSION; and test -x "$_surr_surrogate"
      set _surr_alias (env PATH="$_surr_path" "$_surr_surrogate" alias "$ZMX_SESSION" 2>/dev/null)
    end
    if test -n "$_surr_alias"
      echo "surrogate: zmx session $_surr_session alias $_surr_alias"
    else
      echo "surrogate: zmx session $_surr_session"
    end
  end

  function _surr_wrap_command
    set -l _surr_cmd $argv[1]
    set -e argv[1]
    set -l _surr_zmx (set -q ZMX_BIN; and echo $ZMX_BIN; or echo $HOME/.local/bin/zmx)
    set -l _surr_surrogate (set -q SURROGATE_BIN; and echo $SURROGATE_BIN; or echo $HOME/.local/bin/surrogate)
    set -l _surr_path (dirname "$_surr_surrogate")":"(dirname "$_surr_zmx")":"(string join ":" $PATH)
    set -l _surr_alias ""
    if set -q SURROGATE_NO_ZMX; or not test -x "$_surr_zmx"
      command "$_surr_cmd" $argv
      return $status
    end
    set -l _surr_parent (_surr_parent_name)
    if set -q ZMX_SESSION; or test "$_surr_parent" = "zmx"
      # Already inside zmx — use plain `alias` (not --predict) so renames win.
      if set -q ZMX_SESSION; and test -x "$_surr_surrogate"
        set _surr_alias (env PATH="$_surr_path" "$_surr_surrogate" alias "$ZMX_SESSION" 2>/dev/null)
      end
      set -l _surr_session (set -q ZMX_SESSION; and echo $ZMX_SESSION; or echo inherited)
      if test -n "$_surr_alias"
        echo "surrogate: zmx session $_surr_session alias $_surr_alias"
      else
        echo "surrogate: zmx session $_surr_session"
      end
      command "$_surr_cmd" $argv
      return $status
    end
    set -l _surr_name "$_surr_cmd-"(date +'%Y-%m-%d_%H-%M-%S_%Z')"-$fish_pid"
    if test -x "$_surr_surrogate"
      set _surr_alias (env PATH="$_surr_path" "$_surr_surrogate" alias --predict "$_surr_name" 2>/dev/null)
    end
    if test -n "$_surr_alias"
      echo "surrogate: zmx session $_surr_name alias $_surr_alias"
    else
      echo "surrogate: zmx session $_surr_name"
    end
    env -u ZMX_SESSION "$_surr_zmx" attach "$_surr_name" "$_surr_cmd" $argv
    return $status
  end

  set -l _surr_parent (_surr_parent_name)
EOF

  if [[ "$mode" == "commands" ]]; then
    cat <<'EOF'
  if test "$_surr_parent" != "zmx"
    set -e ZMX_SESSION
  end
EOF
    fish_wrappers "$commands"
  else
    cat <<'EOF'
  if test "$_surr_parent" = "zmx"
    _surr_print_status
  else
    if not set -q SURROGATE_NO_ZMX
      set -l _surr_zmx (set -q ZMX_BIN; and echo $ZMX_BIN; or echo $HOME/.local/bin/zmx)
      if test -x "$_surr_zmx"
        set -l _surr_name (date +'%Y-%m-%d_%H-%M-%S_%Z')"-$fish_pid"
        echo "surrogate: wrapping in zmx session $_surr_name"
        set -e ZMX_SESSION
        exec "$_surr_zmx" attach "$_surr_name"
      end
    end
  end
EOF
  fi

  printf '%s\n' 'end' "$MARKER_END"
}

snippet_for() {
  local shell_name="$1"
  local mode="$2"
  local commands="$3"

  case "$shell_name" in
    bash|zsh)
      snippet_for_bash_like "$mode" "$commands"
      ;;
    fish)
      snippet_for_fish "$mode" "$commands"
      ;;
  esac
}

is_installed() {
  local rc="$1"
  [[ -f "$rc" ]] && grep -qF "$MARKER_BEGIN" "$rc"
}

current_managed_block() {
  local rc="$1"
  [[ -f "$rc" ]] || return 0
  awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
    $0 == begin { print; capture=1; next }
    capture {
      print
      if ($0 == end) {
        exit
      }
    }
  ' "$rc"
}

render_without_managed_block() {
  local rc="$1"
  [[ -f "$rc" ]] || return 0
  awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
    $0 == begin { skip=1; next }
    $0 == end   { skip=0; getline; if ($0 != "") print; next }
    !skip       { print }
  ' "$rc"
}

do_show() {
  local sh="$1"
  local rc="$2"
  local mode="$3"
  local commands="$4"
  local config_path="$5"

  echo "Shell:   $sh"
  echo "RC file: $rc"
  echo "Mode:    $mode"
  if [[ "$mode" == "commands" ]]; then
    echo "Commands: $commands"
  fi
  if [[ -n "$config_path" ]]; then
    echo "Config:  $config_path"
  fi
  echo ""
  echo "Snippet that would be added:"
  echo "---"
  snippet_for "$sh" "$mode" "$commands"
  echo "---"
}

do_check() {
  local rc="$1"
  if is_installed "$rc"; then
    echo "Installed in $rc"
    return 0
  else
    echo "Not installed in $rc"
    return 1
  fi
}

do_install() {
  local rc="$1"
  local desired="$2"
  local current=""
  local action="Installed"

  mkdir -p "$(dirname "$rc")"
  touch "$rc"

  if is_installed "$rc"; then
    current="$(current_managed_block "$rc")"
    if [[ "$current" == "$desired" ]]; then
      echo "Already installed in $rc — nothing to do."
      return 0
    fi
    action="Updated"
  fi

  # Place the managed block at the END of the rc file. In commands mode,
  # user aliases (e.g. `alias codex='bunx ...'`) elsewhere in the rc would
  # otherwise shadow our command wrappers — aliases always win over
  # functions regardless of definition order. We unalias each wrapped
  # command before defining its function, and running last guarantees no
  # later alias definition can re-shadow us.
  local tmp
  tmp="$(mktemp)"
  {
    render_without_managed_block "$rc"
    echo ""
    printf '%s\n' "$desired"
  } > "$tmp"

  mv "$tmp" "$rc"
  echo "$action auto-zmx snippet at end of $rc"
}

do_uninstall() {
  local rc="$1"

  if ! is_installed "$rc"; then
    echo "Not installed in $rc — nothing to do."
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  render_without_managed_block "$rc" > "$tmp"
  mv "$tmp" "$rc"
  echo "Removed auto-zmx snippet from $rc"
}

main() {
  local action="show"
  local cli_mode=""
  local cli_commands=""
  local cli_config=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --show)      action="show"; shift ;;
      --install)   action="install"; shift ;;
      --uninstall) action="uninstall"; shift ;;
      --check)     action="check"; shift ;;
      --mode)
        [[ $# -ge 2 ]] || die "--mode requires a value"
        cli_mode="$2"
        shift 2
        ;;
      --commands)
        [[ $# -ge 2 ]] || die "--commands requires a value"
        cli_commands="$2"
        shift 2
        ;;
      --config)
        [[ $# -ge 2 ]] || die "--config requires a path"
        cli_config="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  local sh rc desired
  sh="$(detect_shell)"
  rc="$(rc_file_for "$sh")"
  resolve_settings "$cli_config" "$cli_mode" "$cli_commands"
  desired="$(snippet_for "$sh" "$RESOLVED_MODE" "$RESOLVED_COMMANDS")"

  case "$action" in
    show)      do_show "$sh" "$rc" "$RESOLVED_MODE" "$RESOLVED_COMMANDS" "$ACTIVE_CONFIG_PATH" ;;
    check)     do_check "$rc" ;;
    install)   do_install "$rc" "$desired" ;;
    uninstall) do_uninstall "$rc" ;;
  esac
}

main "$@"
